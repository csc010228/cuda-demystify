# Ignore build artifacts for C and C++
*.o
*.obj
*.so
*.a
*.lib
*.dll
*.exe
*.out
*.dSYM/
*.pdb
*.exp
*.log
*.signal

# Ignore CMake build directories
build/

# Ignore Python bytecode and caches
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# Ignore virtual environments
venv/
.env/
.virtualenv/

# Ignore IDE and editor settings
.vscode/
.idea/
.claude/
.codex/
*.sublime-workspace
*.swp
*.swo
*.bak

# Ignore compiled Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore .skel.h file generated by libbpf
*.skel.h

# Ignore cuda profiling file
*.nsys-rep
*.ncu-rep

# Ignore reports
.data/